# ---------------------------------------------------------------------------
# Weekend Reads — environment configuration
# Copy this file to .env and fill in the keys you have.
# The generator always works without keys by using the local editorial engine.
# ---------------------------------------------------------------------------

# AI curation (optional). At least one provider enables LLM-written digests.
# Gemini is tried first; Groq is the final fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Google also accepts this name for the Gemini key.
# GOOGLE_API_KEY=

# Comma-separated Gemini model cascade, tried in order.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-1.5-pro

# Groq model used after every Gemini model has failed.
GROQ_MODEL=llama-3.3-70b-versatile

# Set to false to force the local extractive engine even when keys exist.
USE_LLM=true

# Editorial filters.
MIN_WORDS=1000
WINDOW_DAYS=7
MAX_ARTICLES=10
ENRICH_PER_CATEGORY=24
CANDIDATES_PER_CATEGORY=4

# Reading time, in words per minute.
WORDS_PER_MINUTE=220

# Network tuning.
FEED_CONCURRENCY=8
ARTICLE_CONCURRENCY=8
FEED_RETRIES=2
REQUEST_TIMEOUT_MS=20000
LLM_TIMEOUT_MS=120000

# Canonical public URL, used for canonical tags, Open Graph and sitemap.xml.
# Example: https://your-user.github.io/WeekendReads
SITE_URL=

# PDF rendering. Leave blank to auto-detect Chrome/Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Local preview server.
PORT=4173
