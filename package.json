{
  "name": "weekend-reads",
  "version": "1.0.0",
  "private": true,
  "description": "An automated weekly editorial magazine of the best longform journalism.",
  "main": "src/index.js",
  "scripts": {
    "generate": "node src/index.js",
    "generate:no-pdf": "node src/index.js --no-pdf",
    "dev": "node src/server.js",
    "build:assets": "node scripts/prepare-assets.js",
    "postinstall": "node scripts/prepare-assets.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^17.2.3",
    "groq-sdk": "^0.34.0",
    "jsdom": "^27.0.0",
    "pagedjs": "^0.4.3",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "puppeteer": "^24.30.0"
  }
}
